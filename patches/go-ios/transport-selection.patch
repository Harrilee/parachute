diff --git a/ios/connection_selection.go b/ios/connection_selection.go
new file mode 100644
index 0000000..202dc4f
--- /dev/null
+++ b/ios/connection_selection.go
@@ -0,0 +1,42 @@
+package ios
+
+import (
+	"fmt"
+	"sort"
+)
+
+// SelectDevices filters before selection without changing the discovery snapshot.
+// Empty transport preserves discovery of both transports, with USB preferred.
+func SelectDevices(devices DeviceList, udid, transport string) (DeviceList, error) {
+	if transport != "" && transport != "USB" && transport != "Network" {
+		return DeviceList{}, fmt.Errorf("PARACHUTE_CONNECTION_TYPE must be USB or Network, got %q", transport)
+	}
+	selected := DeviceList{DeviceList: make([]DeviceEntry, 0, len(devices.DeviceList))}
+	for _, device := range devices.DeviceList {
+		if (udid == "" || device.Properties.SerialNumber == udid) &&
+			(transport == "" || device.ConnectionTypeLabel() == transport) {
+			selected.DeviceList = append(selected.DeviceList, device)
+		}
+	}
+	priority := func(device DeviceEntry) int {
+		switch device.ConnectionTypeLabel() {
+		case "USB":
+			return 0
+		case "Network":
+			return 1
+		default:
+			return 2
+		}
+	}
+	sort.SliceStable(selected.DeviceList, func(i, j int) bool {
+		a, b := selected.DeviceList[i], selected.DeviceList[j]
+		if priority(a) != priority(b) {
+			return priority(a) < priority(b)
+		}
+		if a.Properties.SerialNumber != b.Properties.SerialNumber {
+			return a.Properties.SerialNumber < b.Properties.SerialNumber
+		}
+		return a.DeviceID < b.DeviceID
+	})
+	return selected, nil
+}
diff --git a/ios/connection_selection_test.go b/ios/connection_selection_test.go
new file mode 100644
index 0000000..31c6d80
--- /dev/null
+++ b/ios/connection_selection_test.go
@@ -0,0 +1,39 @@
+package ios
+
+import "testing"
+
+func parachuteDevice(udid, transport string, id int) DeviceEntry {
+	return DeviceEntry{DeviceID: id, Properties: DeviceProperties{SerialNumber: udid, ConnectionType: transport}}
+}
+
+func TestParachuteSelectionPrefersUSBDeterministically(t *testing.T) {
+	network, usb2, usb1 := parachuteDevice("target", "Network", 1), parachuteDevice("target", "USB", 20), parachuteDevice("target", "USB", 10)
+	for _, order := range [][]DeviceEntry{{network, usb2, usb1}, {usb2, network, usb1}, {usb1, usb2, network}} {
+		result, err := SelectDevices(DeviceList{order}, "target", "")
+		if err != nil || len(result.DeviceList) != 3 || result.DeviceList[0].DeviceID != 10 || result.DeviceList[2].ConnectionTypeLabel() != "Network" {
+			t.Fatalf("selection: %+v, %v", result, err)
+		}
+	}
+	original := DeviceList{[]DeviceEntry{network, usb1}}
+	_, _ = SelectDevices(original, "", "")
+	if original.DeviceList[0] != network {
+		t.Fatal("selection changed the discovery snapshot")
+	}
+}
+
+func TestParachuteSelectionFiltersTargetAndTransport(t *testing.T) {
+	devices := DeviceList{[]DeviceEntry{parachuteDevice("other", "USB", 1), parachuteDevice("target", "Network", 2), parachuteDevice("target", "USB", 3)}}
+	for _, transport := range []string{"USB", "Network"} {
+		result, err := SelectDevices(devices, "target", transport)
+		if err != nil || len(result.DeviceList) != 1 || result.DeviceList[0].Properties.SerialNumber != "target" || result.DeviceList[0].ConnectionTypeLabel() != transport {
+			t.Fatalf("%s: %+v, %v", transport, result, err)
+		}
+	}
+	result, err := SelectDevices(DeviceList{[]DeviceEntry{devices.DeviceList[1]}}, "target", "USB")
+	if err != nil || len(result.DeviceList) != 0 {
+		t.Fatal("USB selection fell back to Network")
+	}
+	if _, err := SelectDevices(devices, "target", "usb"); err == nil {
+		t.Fatal("invalid transport accepted")
+	}
+}
