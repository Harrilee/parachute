index 0000000..1b670a1
--- /dev/null
+++ b/ios/tunnel/parachute_transport_test.go
@@ -0,0 +1,136 @@
+package tunnel
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/Masterminds/semver"
+	"github.com/danielpaulus/go-ios/ios"
+)
+
+type parachuteDevices struct{ devices []ios.DeviceEntry }
+
+func (d *parachuteDevices) ListDevices() (ios.DeviceList, error) {
+	return ios.DeviceList{DeviceList: d.devices}, nil
+}
+
+type parachuteStarter struct {
+	started []ios.DeviceEntry
+	closed  int
+	fail    bool
+}
+
+func (s *parachuteStarter) StartTunnel(_ context.Context, d ios.DeviceEntry, _ PairRecordManager, _ *semver.Version, _ bool) (Tunnel, error) {
+	s.started = append(s.started, d)
+	if s.fail {
+		return Tunnel{}, errors.New("fake startup failed")
+	}
+	return Tunnel{Udid: d.Properties.SerialNumber, closer: func() error { s.closed++; return nil }}, nil
+}
+func parachuteEntry(udid, transport string, id int) ios.DeviceEntry {
+	return ios.DeviceEntry{DeviceID: id, Properties: ios.DeviceProperties{SerialNumber: udid, ConnectionType: transport}}
+}
+func parachuteManager(d *parachuteDevices, s *parachuteStarter) *TunnelManager {
+	return &TunnelManager{dl: d, ts: s, tunnels: map[string]Tunnel{}, startTunnelTimeout: time.Second, getVersion: func(ios.DeviceEntry) (*semver.Version, error) { return semver.MustParse("27.2.0"), nil }}
+}
+
+func TestParachuteTunnelManagerScopesAndDeduplicatesTransport(t *testing.T) {
+	t.Setenv("GO_IOS_UDID", "target")
+	t.Setenv("PARACHUTE_CONNECTION_TYPE", "USB")
+	d := &parachuteDevices{[]ios.DeviceEntry{parachuteEntry("target", "Network", 1), parachuteEntry("other", "USB", 2), parachuteEntry("target", "USB", 4), parachuteEntry("target", "USB", 3)}}
+	s := &parachuteStarter{}
+	m := parachuteManager(d, s)
+	for i := 0; i < 2; i++ {
+		if err := m.UpdateTunnels(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if len(s.started) != 1 || s.started[0].DeviceID != 3 || m.tunnels["target"].ConnectionType != "USB" {
+		t.Fatalf("wrong tunnel selection: %+v", s.started)
+	}
+	d.devices = []ios.DeviceEntry{parachuteEntry("target", "Network", 1)}
+	if err := m.UpdateTunnels(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if len(s.started) != 1 || s.closed != 1 || len(m.tunnels) != 0 {
+		t.Fatal("USB disconnect silently reused Network")
+	}
+}
+
+func TestParachuteTunnelManagerReplacesWirelessWhenUSBAppears(t *testing.T) {
+	t.Setenv("GO_IOS_UDID", "target")
+	t.Setenv("PARACHUTE_CONNECTION_TYPE", "")
+	d := &parachuteDevices{[]ios.DeviceEntry{parachuteEntry("target", "Network", 1)}}
+	s := &parachuteStarter{}
+	m := parachuteManager(d, s)
+	if err := m.UpdateTunnels(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	d.devices = append(d.devices, parachuteEntry("target", "USB", 2))
+	if err := m.UpdateTunnels(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if len(s.started) != 2 || s.closed != 1 || m.tunnels["target"].ConnectionType != "USB" {
+		t.Fatal("existing wireless tunnel bypassed USB preference")
+	}
+}
+
+func TestParachuteTunnelManagerDoesNotFallBackAfterUSBFailure(t *testing.T) {
+	t.Setenv("GO_IOS_UDID", "target")
+	t.Setenv("PARACHUTE_CONNECTION_TYPE", "")
+	d := &parachuteDevices{[]ios.DeviceEntry{parachuteEntry("target", "Network", 1), parachuteEntry("target", "USB", 2)}}
+	s := &parachuteStarter{fail: true}
+	m := parachuteManager(d, s)
+	if err := m.UpdateTunnels(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if len(s.started) != 1 || s.started[0].ConnectionTypeLabel() != "USB" || len(m.tunnels) != 0 {
+		t.Fatal("failed USB silently fell back to Network")
+	}
+	t.Setenv("PARACHUTE_CONNECTION_TYPE", "invalid")
+	if err := m.UpdateTunnels(context.Background()); err == nil || len(s.started) != 1 {
+		t.Fatal("invalid transport reached tunnel startup")
+	}
+}
+
+func TestParachuteTunnelResponsesRequireMatchingIdentityAndTransport(t *testing.T) {
+	t.Setenv("GO_IOS_UDID", "target")
+	t.Setenv("PARACHUTE_CONNECTION_TYPE", "USB")
+	response := Tunnel{Udid: "target", ConnectionType: "USB"}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/tunnels" {
+			_ = json.NewEncoder(w).Encode([]Tunnel{response, {Udid: "target", ConnectionType: "Network"}, {Udid: "other", ConnectionType: "USB"}, {Udid: "target"}})
+		} else {
+			_ = json.NewEncoder(w).Encode(response)
+		}
+	}))
+	defer server.Close()
+	address := server.Listener.Addr().(*net.TCPAddr)
+	for _, transport := range []string{"", "Network", "USB"} {
+		response.ConnectionType = transport
+		_, err := TunnelInfoForDevice("target", address.IP.String(), address.Port)
+		if (err == nil) != (transport == "USB") {
+			t.Fatalf("transport %q validation: %v", transport, err)
+		}
+	}
+	response.Udid = "other"
+	if _, err := TunnelInfoForDevice("target", address.IP.String(), address.Port); err == nil {
+		t.Fatal("wrong device accepted")
+	}
+	response.Udid = "target"
+	listed, err := ListRunningTunnels(address.IP.String(), address.Port)
+	if err != nil || len(listed) != 1 || listed[0].ConnectionType != "USB" {
+		t.Fatalf("wrong filtered list: %+v %v", listed, err)
+	}
+	t.Setenv("PARACHUTE_CONNECTION_TYPE", "")
+	response.ConnectionType = "Network"
+	if _, err := TunnelInfoForDevice("target", address.IP.String(), address.Port, "USB"); err == nil {
+		t.Fatal("implicit USB selection accepted wireless tunnel")
+	}
+}
