diff --git a/parachute_details_test.go b/parachute_details_test.go
new file mode 100644
index 0000000..3c687e2
--- /dev/null
+++ b/parachute_details_test.go
@@ -0,0 +1,51 @@
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/danielpaulus/go-ios/ios"
+)
+
+func parachuteDiscoveryDevices() ios.DeviceList {
+	return ios.DeviceList{DeviceList: []ios.DeviceEntry{
+		{Properties: ios.DeviceProperties{SerialNumber: "target", ConnectionType: "Network"}},
+		{Properties: ios.DeviceProperties{SerialNumber: "target", ConnectionType: "USB"}},
+	}}
+}
+
+func TestParachuteDetailsPreservesHealthyUSBWhenWirelessFails(t *testing.T) {
+	entries := detailedEntries(parachuteDiscoveryDevices(), func(d ios.DeviceEntry) (ios.GetAllValuesResponse, error) {
+		if d.ConnectionTypeLabel() == "Network" {
+			return ios.GetAllValuesResponse{}, errors.New("wireless endpoint refused")
+		}
+		return ios.GetAllValuesResponse{Value: ios.AllValuesType{ProductName: "iPhone", ProductVersion: "27.2"}}, nil
+	}, time.Second)
+	if len(entries) != 2 || entries[0].Udid != "target" || entries[0].ConnectionType != "Network" || entries[0].Error != "wireless endpoint refused" || entries[1].ProductName != "iPhone" || entries[1].Error != "" {
+		t.Fatalf("lost partial results: %+v", entries)
+	}
+	data, err := json.Marshal(entries[1])
+	if err != nil || strings.Contains(string(data), "Error") {
+		t.Fatalf("successful row must omit Error: %s, %v", data, err)
+	}
+}
+
+func TestParachuteDetailsBoundsUnresponsiveWirelessEndpoint(t *testing.T) {
+	release, done := make(chan struct{}), make(chan struct{})
+	defer func() { close(release); <-done }()
+	start := time.Now()
+	entries := detailedEntries(parachuteDiscoveryDevices(), func(d ios.DeviceEntry) (ios.GetAllValuesResponse, error) {
+		if d.ConnectionTypeLabel() == "Network" {
+			<-release
+			close(done)
+			return ios.GetAllValuesResponse{}, errors.New("closed")
+		}
+		return ios.GetAllValuesResponse{Value: ios.AllValuesType{ProductName: "iPhone"}}, nil
+	}, 50*time.Millisecond)
+	if time.Since(start) > time.Second || len(entries) != 2 || entries[0].Error != "device metadata query timed out" || entries[1].ProductName != "iPhone" || entries[1].Error != "" {
+		t.Fatalf("deadline lost healthy USB row: %+v", entries)
+	}
+}
